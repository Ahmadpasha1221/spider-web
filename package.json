{
  "name": "@ahmadpasha1221/spider-web",
  "version": "0.1.2",
  "description": "Local-first, agent-neutral session interoperability foundation",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "spider-web": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmadpasha1221/spider-web.git"
  },
  "bugs": {
    "url": "https://github.com/Ahmadpasha1221/spider-web/issues"
  },
  "homepage": "https://github.com/Ahmadpasha1221/spider-web#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate:types": "json2ts -i schemas/spider-session.schema.json -o src/generated/spider-session.ts && json2ts -i schemas/spider-egg-manifest.schema.json -o src/generated/spider-egg-manifest.ts",
    "typecheck": "npm run generate:types && tsc --noEmit -p tsconfig.json",
    "build": "npm run generate:types && tsc -p tsconfig.build.json",
    "lint": "eslint src test eslint.config.js vitest.config.ts",
    "test": "vitest run",
    "format:check": "prettier --check src test schemas package.json tsconfig.json tsconfig.build.json eslint.config.js vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.291",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^5.1.0",
    "jsonc-parser": "^3.3.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "eslint": "^9.17.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.8"
  }
}